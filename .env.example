# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model + quota tuning. gemini-flash-lite-latest and gemini-3.1-flash-lite have larger
# free-tier daily quotas. Run backend/list_models.py to see what your key allows.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_RPM=15

# Pipeline tuning
FKL_MAX_PAGES=0            # 0 = whole document; set e.g. 30 for a fast demo run
FKL_PAGES_PER_CHUNK=10
FKL_FACTS_PER_CHUNK=25
FKL_TOP_K=4                # candidate comparisons considered per new fact
FKL_MAX_ADJUDICATIONS=50   # LLM comparison budget per uploaded document
